# Entorno
NODE_ENV=development
PORT=3000

# MongoDB (desarrollo local)
MONGODB_URI=mongodb://localhost:27017/stream_app

# Auth JWT
JWT_SECRET=cambiar_por_un_secreto_fuerte
JWT_EXPIRES_IN=30m

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=stream-app
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto

# Prefijos conocidos (carpeta raiz en R2, coma-separados)
R2_PREFIXES=Movies,Series

# Presigned GET TTL (segundos) - SDD ADR-001/respuesta 4
PRESIGN_TTL_SECONDS=600

# Indexacion
SCAN_AUTO_ON_LOGIN=true

# Descargas offline expiran en N dias (respuesta 3)
DOWNLOAD_EXPIRY_DAYS=7
